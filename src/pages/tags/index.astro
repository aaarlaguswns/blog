---
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { getTags } from "@/lib/content"

const tags = await getTags()
---

<Layout crumbs={[{ label: "태그", href: "/tags" }]}>
  <MetaPage slot="head" title="태그" noindex />
  {tags.size > 0 ? (
      <ul>
        {[...tags].map(([tag, posts]) => (
          <li>
            <a href={`/tags/${tag}`}>#{tag}<tag-count>{posts.length}</tag-count></a>
          </li>
        ))}
      </ul>
    ) : (
      <prose-content>
        <p>
          아직 태그를 단 글이 없다. 분류는 <a href="/blog">글 목록</a>의
          폴더 구조가 맡고 있고, 태그는 폴더로 묶이지 않는 주제에 쓸 자리다.
        </p>
      </prose-content>
    )}
</Layout>

<style>
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);

    a {
      display: inline-block;
      padding-inline: var(--space-2xs);
      font-size: var(--step--1);
      color: var(--muted-foreground);
      background-color: color-mix(in oklab, var(--muted) 50%, transparent);
      border-radius: var(--radius-full);
      text-decoration-line: none;

      &:hover {
        color: var(--foreground);
      }

      tag-count {
        margin-inline-start: var(--space-3xs);
        opacity: 0.6;
      }
    }
  }
</style>
