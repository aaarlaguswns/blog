---
/*
 * 글 목록. 분류에 상관없이 최신순으로 전부 늘어놓는다.
 *
 * 갈래별로 보고 싶으면 /categories 로 간다. 여기서까지 분류별로 접어 보여주면
 * 두 페이지가 같은 일을 하게 되고, 어느 쪽도 제 역할을 못 한다.
 */
import BlogCard from "@/components/BlogCard.astro"
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { getCategoryTree, getPosts } from "@/lib/content"

const posts = await getPosts()
const { roots } = await getCategoryTree()
---

<Layout>
  <MetaPage slot="head" title="글" />

  <page-head>
    <h1>글</h1>
    <p>
      전체 {posts.length}개.
      {roots.length > 0 && (
        <>갈래별로 보려면 <a href="/categories">분류</a>로.</>
      )}
    </p>
  </page-head>

  <ul>
    {posts.map((post) => <BlogCard post={post} />)}
  </ul>
</Layout>

<style>
  page-head {
    display: block;
    margin-block-end: var(--space-m);

    h1 {
      font-size: var(--step-2);
      line-height: calc(var(--leading-offset) + 1em);
      font-weight: var(--font-weight-medium);
    }

    p {
      margin-block-start: var(--space-3xs);
      font-size: var(--step--1);
      color: var(--muted-foreground);
    }
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }
</style>
