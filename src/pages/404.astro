---
/*
 * 없는 주소로 들어왔을 때.
 *
 * 마스코트(핑구 팬아트)를 아스키아트로 보여준다. 탭 아이콘과 같은 원본(mascot.json)에서
 * 도트 한 칸을 글자 두 개로 바꿔 그리므로 모양이 어긋날 일이 없다.
 * (고정폭 글자는 세로로 길어서, 한 칸에 두 글자를 써야 정사각형에 가까워진다)
 */
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import mascot from "../../mascot.json"

const GLYPHS: Record<string, string> = {
  K: "##", // 몸
  W: "::", // 배·얼굴
  E: "@@", // 눈
  O: "==", // 부리·발
}

const art = mascot.pixels
  .map((row) =>
    [...row]
      .map((ch) => (GLYPHS[ch] ? `<i data-c="${ch}">${GLYPHS[ch]}</i>` : "  "))
      .join(""),
  )
  .join("\n")
---

<Layout crumbs={[{ label: "404", href: "/404" }]}>
  <MetaPage slot="head" title="404" noindex />
  <lost-page>
    <pre aria-hidden="true" set:html={art} />
    <h1>404</h1>
    <p>여기엔 아무것도 없다. 주소가 바뀌었거나 내려간 글일 수 있다.</p>
    <nav>
      <a href="/">홈</a>
      <a href="/blog">글 목록</a>
      <a href="/categories">분류</a>
    </nav>
  </lost-page>
</Layout>

<style>
  lost-page {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2xs);
  }

  pre {
    margin-block-end: var(--space-s);
    font-family: var(--font-mono);
    font-size: clamp(0.5rem, 1.6vw, 0.8rem);
    line-height: 1.05;
    letter-spacing: 0;
    user-select: none;

    @media (prefers-reduced-motion: no-preference) {
      animation: waddle 2.4s ease-in-out infinite;
      transform-origin: 50% 100%;
    }

    :global(i) {
      font-style: normal;
    }

    /*
     * 실제 핑구처럼 몸은 어둡게, 눈·배는 밝게. 글자색(--foreground)을 그대로 쓰면
     * 다크모드에서 몸이 하얘지고 눈이 어두워져 반전된 그림이 된다.
     */
    :global(i[data-c="K"]),
    :global(i[data-c="E"]) {
      color: light-dark(#1f1f1f, #6b6b6b);
    }

    :global(i[data-c="W"]) {
      color: light-dark(#a3a3a3, #ededed);
    }

    :global(i[data-c="O"]) {
      color: light-dark(#ea580c, #fb923c);
    }
  }

  /* 뒤뚱뒤뚱 */
  @keyframes waddle {
    0%, 100% { transform: rotate(-3deg); }
    50% { transform: rotate(3deg); }
  }

  h1 {
    font-size: var(--step-3);
    font-weight: var(--font-weight-medium);
    line-height: 1.1;
  }

  p {
    color: var(--muted-foreground);
  }

  nav {
    display: flex;
    gap: var(--space-s);
    margin-block-start: var(--space-xs);
  }
</style>
