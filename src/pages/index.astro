---
import BlogCard from "@/components/BlogCard.astro"
import ParticleTitle from "@/components/ParticleTitle.astro"
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { getPosts } from "@/lib/content"
import { SITE } from "@/consts"

const posts = await getPosts()
const recent = posts.slice(0, 6)
const hasMore = posts.length > recent.length
---

<Layout>
  <MetaPage slot="head" />

  <site-intro>
    <ParticleTitle text={SITE.title} />
  </site-intro>

  <hr>

  <section>
    <section-head>
      <h2>최근 글</h2>
      {hasMore && <a href="/blog">전체 보기</a>}
    </section-head>

    {recent.length > 0 ? (
        <ul>
          {recent.map((post) => <BlogCard post={post} />)}
        </ul>
      ) : (
        <prose-content><p>아직 쓴 글이 없다.</p></prose-content>
      )}
  </section>
</Layout>

<style>
  site-intro {
    display: block;

    @media (width >= 64rem) {
      margin-block-start: -0.2em;
    }

    particle-title {
      margin-block-end: var(--space-xs);
    }

  }

  hr {
    margin-block: var(--space-m);
    border-block-start: 2px solid var(--border);
  }

  section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
    margin-block-end: var(--space-s);

    h2 {
      font-size: var(--step-0);
      font-weight: var(--font-weight-medium);
    }

    a {
      font-size: var(--step--1);
      color: var(--muted-foreground);

      &:hover {
        color: var(--foreground);
      }
    }
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }
</style>
