---
/*
 * 옵시디언·쿼츠 같은 그래프 뷰.
 *
 *   focus 를 주면 그 노드 주변만 보여주는 "로컬 그래프" (글·분류 페이지)
 *   안 주면 전체 그래프 (홈·목록 페이지)
 *
 * 확대 버튼을 누르면 전체 그래프가 화면 가득 열린다. 거기서는 휠로 확대/축소된다.
 * 사이드바의 작은 그래프는 휠을 가로채지 않는다 — 페이지 스크롤을 막으면 안 되니까.
 *
 * 데이터는 /graph.json (src/pages/graph.json.ts) 에서 가져온다.
 */
type Props = {
  /** "post:algorithm/binary-search/1920" 또는 "cat:algorithm" 꼴 */
  focus?: string
}

const { focus } = Astro.props
---

<graph-view data-focus={focus}>
  <graph-head>
    <span>{focus ? "연결된 글" : "그래프"}</span>
    <button type="button" data-expand aria-label="전체 그래프 크게 보기" title="전체 그래프">
      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
        <path d="M2 6V2h4M14 6V2h-4M2 10v4h4M14 10v4h-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </graph-head>
  <graph-canvas><canvas aria-label="글 연결 그래프" role="img"></canvas></graph-canvas>

  <dialog data-global>
    <graph-dialog-head>
      <span>전체 그래프</span>
      <small>드래그로 이동 · 휠로 확대 · 점을 누르면 그 글로</small>
      <button type="button" data-close aria-label="닫기">✕</button>
    </graph-dialog-head>
    <graph-canvas><canvas aria-label="전체 글 연결 그래프" role="img"></canvas></graph-canvas>
  </dialog>
</graph-view>

<script>
  import {
    forceCenter, forceCollide, forceLink, forceManyBody, forceSimulation, forceX, forceY,
    type Simulation, type SimulationLinkDatum, type SimulationNodeDatum,
  } from "d3-force"

  type NodeType = "post" | "cat" | "tag"
  type RawNode = { id: string; label: string; type: NodeType; url: string; group: string | null }
  type RawLink = { source: string; target: string; kind: "link" | "cat" | "tag" }
  type Graph = { nodes: RawNode[]; links: RawLink[]; groups: Record<string, [string, string]> }

  type N = SimulationNodeDatum & RawNode & { degree: number }
  type L = SimulationLinkDatum<N> & { kind: RawLink["kind"] }

  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches

  /* ── 데이터 ─────────────────────────────────────────────────────────── */

  let graphPromise: Promise<Graph> | null = null
  const loadGraph = () =>
    (graphPromise ??= fetch("/graph.json").then((r) => r.json() as Promise<Graph>))

  /**
   * 로컬 그래프: focus 에서 두 걸음 안의 노드.
   * 태그는 끝점으로만 넣고 그 너머로는 퍼지지 않는다 — #C++ 하나만 타고 넘어가도
   * 스무 개 넘는 글이 딸려 들어와 "주변" 이 아니게 된다.
   */
  function localSubgraph(g: Graph, focus: string, depth = 2): Graph {
    const adj = new Map<string, string[]>()
    for (const l of g.links) {
      adj.set(l.source, [...(adj.get(l.source) ?? []), l.target])
      adj.set(l.target, [...(adj.get(l.target) ?? []), l.source])
    }
    const type = new Map(g.nodes.map((n) => [n.id, n.type]))
    const keep = new Set([focus])
    let frontier = [focus]
    for (let d = 0; d < depth; d++) {
      const next: string[] = []
      for (const id of frontier) {
        if (id !== focus && type.get(id) === "tag") continue
        for (const nb of adj.get(id) ?? []) {
          if (!keep.has(nb)) {
            keep.add(nb)
            next.push(nb)
          }
        }
      }
      frontier = next
    }
    return {
      nodes: g.nodes.filter((n) => keep.has(n.id)),
      links: g.links.filter((l) => keep.has(l.source) && keep.has(l.target)),
      groups: g.groups,
    }
  }

  /* ── 색 ─────────────────────────────────────────────────────────────── */

  const isDark = () => {
    const t = document.documentElement.dataset.theme
    return t ? t === "dark" : matchMedia("(prefers-color-scheme: dark)").matches
  }

  /*
   * 테마 색을 캔버스가 알아듣는 값으로 바꾼다.
   * 색 변수들이 light-dark(#밝을때, #어두울때) 꼴이라 getPropertyValue 로 읽으면
   * 그 글자 그대로가 나오고, 캔버스는 그걸 모르는 색으로 보고 무시한다(→ 검정).
   * 진짜 color 속성에 한 번 걸어서 브라우저가 풀어준 rgb 를 받아온다.
   */
  let probe: HTMLSpanElement | null = null
  function resolveColor(cssVar: string, fallback: string) {
    if (!probe) {
      probe = document.createElement("span")
      probe.style.display = "none"
      document.body.append(probe)
    }
    probe.style.color = ""
    probe.style.color = `var(${cssVar})`
    return getComputedStyle(probe).color || fallback
  }

  function readColors() {
    const cs = getComputedStyle(document.body)
    return {
      fg: resolveColor("--foreground", "#222"),
      muted: resolveColor("--muted-foreground", "#888"),
      border: resolveColor("--border", "#ccc"),
      bg: resolveColor("--background", "#fff"),
      font: cs.fontFamily || "sans-serif",
      dark: isDark(),
    }
  }

  /* ── 그리는 쪽 ──────────────────────────────────────────────────────── */

  type Options = { zoomable: boolean; focus: string | null; maxScale: number }

  class GraphRenderer {
    private ctx: CanvasRenderingContext2D
    private nodes: N[]
    private links: L[]
    private sim: Simulation<N, L>
    private neighbors = new Map<string, Set<string>>()
    private colors = readColors()
    private k = 1
    private tx = 0
    private ty = 0
    private userMoved = false
    private hover: N | null = null
    private dragging: N | null = null
    private panning: { x: number; y: number; tx: number; ty: number } | null = null
    private downAt: { x: number; y: number } | null = null
    private raf = 0
    private cleanup: (() => void)[] = []

    constructor(
      private canvas: HTMLCanvasElement,
      graph: Graph,
      private groups: Graph["groups"],
      private opts: Options,
    ) {
      this.ctx = canvas.getContext("2d")!
      this.nodes = graph.nodes.map((n) => ({ ...n, degree: 0 }))
      const byId = new Map(this.nodes.map((n) => [n.id, n]))
      this.links = graph.links
        .filter((l) => byId.has(l.source) && byId.has(l.target))
        .map((l) => ({ source: l.source, target: l.target, kind: l.kind }))

      for (const l of graph.links) {
        const a = byId.get(l.source), b = byId.get(l.target)
        if (!a || !b) continue
        a.degree++; b.degree++
        if (!this.neighbors.has(a.id)) this.neighbors.set(a.id, new Set())
        if (!this.neighbors.has(b.id)) this.neighbors.set(b.id, new Set())
        this.neighbors.get(a.id)!.add(b.id)
        this.neighbors.get(b.id)!.add(a.id)
      }

      this.sim = forceSimulation<N, L>(this.nodes)
        .force(
          "link",
          forceLink<N, L>(this.links)
            .id((d) => d.id)
            .distance((l) => (l.kind === "cat" ? 32 : l.kind === "tag" ? 52 : 42))
            .strength((l) => (l.kind === "tag" ? 0.15 : 0.7)),
        )
        // 반발력이 끝없이 닿으면 서로 안 이어진 덩어리(JavaScript 처럼 태그가 없는 분류)가
        // 멀리 날아가서 전체가 개미만 하게 줄어든다. 닿는 거리를 끊고, 가운데로 살짝 당긴다.
        .force("charge", forceManyBody<N>().strength((d) => (d.type === "cat" ? -140 : -45)).distanceMax(200))
        .force("x", forceX<N>(0).strength(0.08))
        .force("y", forceY<N>(0).strength(0.08))
        .force("center", forceCenter(0, 0))
        .force("collide", forceCollide<N>((d) => this.radius(d) + 3))

      if (reduceMotion) {
        // 움직임을 줄이도록 설정했다면 자리를 미리 다 잡아놓고 한 번만 그린다
        this.sim.stop()
        for (let i = 0; i < 300; i++) this.sim.tick()
        this.fit()
      } else {
        this.sim.on("tick", () => {
          if (!this.userMoved) this.fit()
          this.requestDraw()
        })
      }

      this.resize()
      this.bindEvents()
    }

    private radius(n: N) {
      if (n.id === this.opts.focus) return 6.5
      if (n.type === "cat") return 5 + Math.min(5, Math.sqrt(n.degree))
      if (n.type === "tag") return 4.5
      return 3.5
    }

    private accent(group: string | null) {
      const pair = group ? this.groups[group] : null
      if (!pair) return this.colors.muted
      return this.colors.dark ? pair[1] : pair[0]
    }

    /* 화면 맞춤 · 크기 */

    private fit() {
      const w = this.canvas.clientWidth, h = this.canvas.clientHeight
      if (!w || !h || !this.nodes.length) return
      let x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity
      for (const n of this.nodes) {
        const r = this.radius(n) + 14 // 아래 붙는 이름표 자리까지
        x0 = Math.min(x0, (n.x ?? 0) - r); x1 = Math.max(x1, (n.x ?? 0) + r)
        y0 = Math.min(y0, (n.y ?? 0) - r); y1 = Math.max(y1, (n.y ?? 0) + r)
      }
      const pad = 10
      this.k = Math.min((w - pad * 2) / (x1 - x0 || 1), (h - pad * 2) / (y1 - y0 || 1), this.opts.maxScale)
      this.tx = w / 2 - this.k * (x0 + x1) / 2
      this.ty = h / 2 - this.k * (y0 + y1) / 2
    }

    resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2)
      const w = this.canvas.clientWidth, h = this.canvas.clientHeight
      this.canvas.width = Math.round(w * dpr)
      this.canvas.height = Math.round(h * dpr)
      if (!this.userMoved) this.fit()
      this.draw()
    }

    refreshColors() {
      this.colors = readColors()
      this.draw()
    }

    /* 입력 */

    private toWorld(e: PointerEvent | WheelEvent) {
      const r = this.canvas.getBoundingClientRect()
      const sx = e.clientX - r.left, sy = e.clientY - r.top
      return { sx, sy, x: (sx - this.tx) / this.k, y: (sy - this.ty) / this.k }
    }

    private hit(x: number, y: number): N | null {
      let best: N | null = null, bestD = Infinity
      for (const n of this.nodes) {
        const d = Math.hypot((n.x ?? 0) - x, (n.y ?? 0) - y)
        const reach = this.radius(n) + 5 / this.k
        if (d < reach && d < bestD) { best = n; bestD = d }
      }
      return best
    }

    private bindEvents() {
      const c = this.canvas
      const on = <K extends keyof HTMLElementEventMap>(
        type: K, fn: (e: HTMLElementEventMap[K]) => void, opts?: AddEventListenerOptions,
      ) => {
        c.addEventListener(type, fn as EventListener, opts)
        this.cleanup.push(() => c.removeEventListener(type, fn as EventListener))
      }

      on("pointerdown", (e) => {
        const p = this.toWorld(e)
        this.downAt = { x: p.sx, y: p.sy }
        c.setPointerCapture(e.pointerId)
        const n = this.hit(p.x, p.y)
        if (n) {
          this.dragging = n
          n.fx = n.x; n.fy = n.y
          if (!reduceMotion) this.sim.alphaTarget(0.25).restart()
        } else {
          this.panning = { x: p.sx, y: p.sy, tx: this.tx, ty: this.ty }
        }
      })

      on("pointermove", (e) => {
        const p = this.toWorld(e)
        if (this.dragging) {
          this.dragging.fx = p.x; this.dragging.fy = p.y
          if (reduceMotion) { this.dragging.x = p.x; this.dragging.y = p.y }
          this.userMoved = true
          this.requestDraw()
          return
        }
        if (this.panning) {
          this.tx = this.panning.tx + (p.sx - this.panning.x)
          this.ty = this.panning.ty + (p.sy - this.panning.y)
          this.userMoved = true
          this.requestDraw()
          return
        }
        const n = this.hit(p.x, p.y)
        if (n !== this.hover) {
          this.hover = n
          c.style.cursor = n ? "pointer" : "grab"
          this.requestDraw()
        }
      })

      const release = (e: PointerEvent) => {
        const moved = this.downAt
          ? Math.hypot(this.toWorld(e).sx - this.downAt.x, this.toWorld(e).sy - this.downAt.y) > 4
          : true
        const clicked = this.dragging
        if (this.dragging) {
          this.dragging.fx = null; this.dragging.fy = null
          if (!reduceMotion) this.sim.alphaTarget(0)
        }
        this.dragging = null
        this.panning = null
        this.downAt = null
        // 끌지 않고 짧게 눌렀으면 그 글로 간다
        if (clicked && !moved && e.type === "pointerup") location.href = clicked.url
      }
      on("pointerup", release)
      on("pointercancel", release)
      on("pointerleave", () => {
        if (this.hover && !this.dragging) { this.hover = null; this.requestDraw() }
      })

      if (this.opts.zoomable) {
        on("wheel", (e) => {
          e.preventDefault()
          const p = this.toWorld(e)
          const k = Math.min(6, Math.max(0.2, this.k * Math.exp(-e.deltaY * 0.0015)))
          this.tx = p.sx - p.x * k
          this.ty = p.sy - p.y * k
          this.k = k
          this.userMoved = true
          this.requestDraw()
        }, { passive: false })
      }
    }

    /* 그리기 */

    private requestDraw() {
      if (this.raf) return
      this.raf = requestAnimationFrame(() => { this.raf = 0; this.draw() })
    }

    draw() {
      const { ctx, canvas, k } = this
      const dpr = canvas.width / (canvas.clientWidth || 1)
      ctx.setTransform(1, 0, 0, 1, 0, 0)
      ctx.clearRect(0, 0, canvas.width, canvas.height)
      ctx.setTransform(dpr * k, 0, 0, dpr * k, dpr * this.tx, dpr * this.ty)

      const focusId = this.opts.focus
      const active = this.hover
      const lit = active ? new Set([active.id, ...(this.neighbors.get(active.id) ?? [])]) : null

      // 선
      for (const l of this.links) {
        const s = l.source as N, t = l.target as N
        const touches = !active || s.id === active.id || t.id === active.id
        ctx.globalAlpha = active ? (touches ? 0.9 : 0.06) : l.kind === "link" ? 0.75 : 0.45
        ctx.strokeStyle = touches && active ? this.accent(active.group) : this.colors.muted
        ctx.lineWidth = (l.kind === "link" ? 1.6 : 1) / k
        ctx.setLineDash(l.kind === "tag" ? [3 / k, 3 / k] : [])
        ctx.beginPath()
        ctx.moveTo(s.x ?? 0, s.y ?? 0)
        ctx.lineTo(t.x ?? 0, t.y ?? 0)
        ctx.stroke()
      }
      ctx.setLineDash([])

      // 점
      for (const n of this.nodes) {
        const r = this.radius(n)
        ctx.globalAlpha = lit && !lit.has(n.id) ? 0.18 : 1
        ctx.beginPath()
        ctx.arc(n.x ?? 0, n.y ?? 0, r, 0, Math.PI * 2)
        if (n.type === "tag") {
          ctx.fillStyle = this.colors.bg
          ctx.fill()
          ctx.lineWidth = 1.5 / k
          ctx.strokeStyle = this.colors.muted
          ctx.stroke()
        } else {
          ctx.fillStyle = n.id === focusId ? this.colors.fg : this.accent(n.group)
          ctx.fill()
        }
        if (n.id === focusId || n === active) {
          ctx.beginPath()
          ctx.arc(n.x ?? 0, n.y ?? 0, r + 3 / k, 0, Math.PI * 2)
          ctx.lineWidth = 1.5 / k
          ctx.strokeStyle = this.colors.fg
          ctx.stroke()
        }
      }

      // 이름표: 분류·현재 글은 늘, 나머지는 가리키거나 충분히 확대했을 때만
      ctx.font = `${11 / k}px ${this.colors.font}`
      ctx.textAlign = "center"
      ctx.textBaseline = "top"
      ctx.lineJoin = "round"
      for (const n of this.nodes) {
        // 작은 전체 그래프에서는 최상위 분류 이름만. 하위 분류까지 다 쓰면 서로 겹친다.
        const catLabel =
          (n.type === "cat" && (this.opts.zoomable || this.opts.focus !== null || !n.id.includes("/"))) ||
          (n.type === "tag" && this.opts.zoomable)
        // 글 이름은 가리켰을 때, 또는 큰 화면에서 충분히 확대했을 때만
        const show =
          n.id === focusId || catLabel || (lit ? lit.has(n.id) : this.opts.zoomable && k > 1.8)
        if (!show) continue
        ctx.globalAlpha = lit && !lit.has(n.id) ? 0.25 : 1
        const label = n.label.length > 22 ? `${n.label.slice(0, 21)}…` : n.label
        const y = (n.y ?? 0) + this.radius(n) + 3 / k
        ctx.lineWidth = 3 / k
        ctx.strokeStyle = this.colors.bg
        ctx.strokeText(label, n.x ?? 0, y)
        ctx.fillStyle = n.type === "cat" ? this.accent(n.group) : this.colors.fg
        ctx.fillText(label, n.x ?? 0, y)
      }
      ctx.globalAlpha = 1
    }

    destroy() {
      this.sim.stop()
      cancelAnimationFrame(this.raf)
      for (const f of this.cleanup) f()
    }
  }

  /* ── 붙이기 ─────────────────────────────────────────────────────────── */

  const live = new Set<GraphRenderer>()

  // 테마가 바뀌면 다시 칠한다 (토글·시스템 설정 둘 다)
  new MutationObserver(() => live.forEach((r) => r.refreshColors())).observe(
    document.documentElement, { attributes: true, attributeFilter: ["data-theme"] },
  )
  matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () =>
    live.forEach((r) => r.refreshColors()),
  )

  function mount(canvas: HTMLCanvasElement, graph: Graph, opts: Options) {
    const r = new GraphRenderer(canvas, graph, graph.groups, opts)
    live.add(r)
    const ro = new ResizeObserver(() => r.resize())
    ro.observe(canvas)
    return () => { ro.disconnect(); r.destroy(); live.delete(r) }
  }

  for (const el of document.querySelectorAll<HTMLElement>("graph-view")) {
    const focus = el.dataset.focus || null
    const small = el.querySelector<HTMLCanvasElement>("graph-canvas canvas")!
    const dialog = el.querySelector<HTMLDialogElement>("dialog[data-global]")!
    const big = dialog.querySelector<HTMLCanvasElement>("canvas")!

    // 사이드바가 화면에 보일 때만 데이터를 받고 그린다 (모바일에선 숨겨져 있다)
    const io = new IntersectionObserver(async (entries) => {
      if (!entries.some((e) => e.isIntersecting)) return
      io.disconnect()
      const g = await loadGraph()
      const sub = focus ? localSubgraph(g, focus) : g
      if (!sub.nodes.length) { el.hidden = true; return }
      mount(small, sub, { zoomable: false, focus, maxScale: focus ? 2.2 : 1.6 })
    })
    io.observe(el)

    let unmountBig: (() => void) | null = null
    el.querySelector("[data-expand]")!.addEventListener("click", async () => {
      dialog.showModal()
      const g = await loadGraph()
      unmountBig?.()
      unmountBig = mount(big, g, { zoomable: true, focus, maxScale: 2.5 })
    })
    dialog.querySelector("[data-close]")!.addEventListener("click", () => dialog.close())
    // 바깥(어두운 배경)을 누르면 닫는다
    dialog.addEventListener("click", (e) => { if (e.target === dialog) dialog.close() })
    dialog.addEventListener("close", () => { unmountBig?.(); unmountBig = null })
  }
</script>

<style>
  graph-view {
    display: flex;
    flex-direction: column;
    block-size: 100%;
    border: 1px solid var(--border);
    border-radius: var(--radius-md, 10px);
    overflow: hidden;
    background-color: var(--background);
  }

  graph-head,
  graph-dialog-head {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: var(--space-3xs) var(--space-2xs) var(--space-3xs) var(--space-xs);
    font-size: var(--step--1);
    font-weight: var(--font-weight-medium);
    color: var(--muted-foreground);

    small {
      font-weight: var(--font-weight-normal);
      opacity: 0.7;
    }

    button {
      margin-inline-start: auto;
      display: inline-grid;
      place-items: center;
      inline-size: 1.75rem;
      block-size: 1.75rem;
      border-radius: 6px;
      color: var(--muted-foreground);
      cursor: pointer;

      &:hover {
        color: var(--foreground);
        background-color: var(--muted);
      }
    }
  }

  graph-canvas {
    display: block;
    flex: 1;
    min-block-size: 0;

    canvas {
      display: block;
      inline-size: 100%;
      block-size: 100%;
      cursor: grab;
      touch-action: none;
    }
  }

  dialog {
    inline-size: min(92vw, 1100px);
    block-size: min(86vh, 800px);
    max-inline-size: none;
    max-block-size: none;
    margin: auto;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-md, 12px);
    background-color: var(--background);
    color: var(--foreground);

    &[open] {
      display: flex;
      flex-direction: column;
