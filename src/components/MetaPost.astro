---
import type { CollectionEntry } from "astro:content"
import { SITE } from "@/consts"
import { categoryLabel, pageTitle } from "@/lib/content"

type Props = {
  post: CollectionEntry<"blog">
  canonical?: string
}

const { post, canonical: canonicalPath } = Astro.props
const { title, description, date, image, tags } = post.data

const base = Astro.site ?? new URL(Astro.url.origin)
const url = new URL(Astro.url.pathname, base)
const canonical = new URL(canonicalPath ?? Astro.url.pathname, base)
const ogImage = image
  ? new URL(image.src, base)
  : new URL(SITE.defaultPostImage, base)

// 분류 경로: "algorithm/binary-search" → ["algorithm", "algorithm/binary-search"]
const segments = post.id.split("/").slice(0, -1)
const trail = segments.map((_, i) => segments.slice(0, i + 1).join("/"))
const trailLabels = trail.map(categoryLabel)

/*
 * 검색결과에 뜨는 설명.
 * 코드만 있는 글은 요약이 "C++ 코드" 한 마디뿐이라, 스무 개 넘는 글이 같은 설명을 갖는다.
 * 검색엔진은 설명이 같은 페이지들을 사실상 같은 페이지로 보고 묶어버린다.
 * 짧을 때는 제목과 분류를 붙여 글마다 달라지게 한다. (본문의 요약 자체는 건드리지 않는다)
 */
const metaDescription =
  description.length >= 40
    ? description
    : [title, description, trailLabels.length ? trailLabels.join(" › ") : null]
        .filter(Boolean)
        .join(" — ")

/*
 * 구조화 데이터. 검색엔진이 "이건 블로그 글이고, 언제 누가 썼고, 어느 분류 아래 있다" 를
 * 문장 해석 없이 바로 읽게 한다. 구글은 이걸로 검색결과에 날짜와 경로(빵부스러기)를 붙인다.
 */
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description: metaDescription,
    datePublished: date.toISOString(),
    dateModified: date.toISOString(),
    inLanguage: SITE.locale,
    url: canonical.href,
    mainEntityOfPage: canonical.href,
    image: ogImage.href,
    author: { "@type": "Person", name: SITE.author, url: base.href },
    publisher: { "@type": "Person", name: SITE.author, url: base.href },
    ...(tags?.length ? { keywords: tags.join(", ") } : {}),
    ...(trailLabels.length ? { articleSection: trailLabels.join(" › ") } : {}),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "글", item: new URL("/blog/", base).href },
      ...trail.map((path, i) => ({
        "@type": "ListItem",
        position: i + 2,
        name: trailLabels[i],
        item: new URL(`/blog/${path}/`, base).href,
      })),
      { "@type": "ListItem", position: trail.length + 2, name: title, item: canonical.href },
    ],
  },
]
---

<title>{pageTitle(title)}</title>
<meta name="description" content={metaDescription}>
<link rel="canonical" href={canonical}>

<meta property="og:title" content={title}>
<meta property="og:description" content={metaDescription}>
<meta property="og:type" content="article">
<meta property="og:url" content={url}>
<meta property="og:site_name" content={SITE.title}>
<meta property="og:locale" content={SITE.locale.replace("-", "_")}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:alt" content={title}>

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={metaDescription}>
<meta name="twitter:image" content={ogImage}>
<meta name="twitter:image:alt" content={title}>
<meta property="article:published_time" content={date.toISOString()}>
<meta property="article:author" content={SITE.author}>
{tags?.map((tag) => <meta property="article:tag" content={tag} />)}

<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
